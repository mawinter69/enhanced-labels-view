<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout"
         xmlns:t="/lib/hudson">
  <st:adjunct includes="io.jenkins.plugins.enhanced_labels_view.style"/>
  <st:adjunct includes="io.jenkins.plugins.enhanced_labels_view.labels.AgentDetailsLabelAction.toggle"/>
  <div class="elv-container">
    <h2 class="elv-title"><button class="jenkins-button" tooltip="${%Expand agent details}"><l:icon src="symbol-chevron-forward plugin-ionicons-api" class="icon-lg"/></button>${%Agents}</h2>
    <div class="elv-summary">
      <j:forEach var="status" items="${it.agentStatusList}">
        <div class="elv-summary-entry">
          <l:icon src="${status.symbol()}" class="icon-lg" tooltip="${status.tooltip()}"/>
          <span>${status.count()}</span>
        </div>
      </j:forEach>
    </div>
    <div class="elv-agent-list-short">
      <j:forEach var="entry" items="${it.computers}">
        <div class="elv-agent-list-short-entry">
          <l:icon src="${entry.iconClassName}" class="icon-sm" tooltip="${entry.tooltip}"/>
          <a href="${rootURL}/${entry.url}" class="model-link">${entry.displayName}</a>
        </div>
      </j:forEach>
    </div>
    <div class="elv-agent-table jenkins-hidden">
      <j:set var="columns" value="${it.columns}"/>
      <j:set var="agent" value="${it.columns}"/>
      <t:setIconSize/>
      <j:getStatic var="extendedReadPermission" className="hudson.model.Computer" field="EXTENDED_READ"/>
      <table class="jenkins-table sortable ${iconSize == '16x16' ? 'jenkins-table--small' : iconSize == '24x24' ? 'jenkins-table--medium' : ''}">
        <thead>
          <tr>
            <th class="jenkins-table__cell--tight">S</th>
            <th align="right">${%Name}</th>
            <j:forEach var="column" items="${columns}">
              <st:include page="columnHeader.jelly" it="${column}" />
            </j:forEach>
          </tr>
        </thead>
        <tbody>
          <j:forEach var="agent" items="${it.computers}">
            <tr>
              <td data="${c.icon}" class="jenkins-table__cell--tight jenkins-table__icon">
                <div class="jenkins-table__cell__button-wrapper">
                  <l:icon src="${agent.iconClassName}" alt="${agent.iconAltText}" tooltip="${agent.tooltip}"/>
                </div>
              </td>

              <td align="right"><a href="${rootURL}/${agent.url}" class="jenkins-table__link model-link">${agent.displayName}</a></td>
              <j:forEach var="column" items="${columns}">
                <st:include page="column.jelly" it="${column}" />
              </j:forEach>
            </tr>
          </j:forEach>
        </tbody>
      </table>
    </div>
  </div>
</j:jelly>